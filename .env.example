# Client
CLIENT_PORT=5173
VITE_API_BASE_URL=http://localhost:4000/api

# Server
SERVER_PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://username:password@localhost:5432/ai_vr_career_guidance
CORS_ORIGIN=http://localhost:5173

# Authentication
AUTH_SECRET=replace-with-a-local-development-secret
TOKEN_EXPIRY=1d

# AI advisor
# Gemini is server-only. Use a Gemini Free Tier project and do not enable billing.
# Keep GEMINI_API_KEY private; deterministic fallback remains available when disabled.
AI_ADVISOR_ENABLED=true
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GEMINI_ENABLED=false
GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MAX_OUTPUT_TOKENS=900
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RESPONSE_CHARS=4000
AI_RETRY_ATTEMPTS=1

# Optional database settings
DB_POOL_MIN=1
DB_POOL_MAX=10
