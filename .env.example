# Client
CLIENT_PORT=5173
VITE_API_BASE_URL=http://localhost:4000/api

# Server
SERVER_PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://username:password@localhost:5432/ai_vr_career_guidance
CORS_ORIGIN=http://localhost:5173

# Authentication
AUTH_SECRET=replace-with-a-local-development-secret
TOKEN_EXPIRY=1d

# AI provider
AI_API_KEY=replace-with-a-local-key
AI_MODEL=replace-with-an-approved-model
AI_API_BASE_URL=https://api.example.com/v1

# Optional database settings
DB_POOL_MIN=1
DB_POOL_MAX=10
