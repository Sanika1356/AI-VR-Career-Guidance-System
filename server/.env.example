# Runtime
NODE_ENV=development
SERVER_PORT=4000
CORS_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT_BYTES=1000000
# Feature flags: preserve the released advisor by default; keep external data and unfinished WebXR off.
AI_ADVISOR_ENABLED=true
EXTERNAL_CAREER_DATA_ENABLED=false
WEBXR_ENABLED=false

# Local PostgreSQL; no hosted database is required for development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_vr_career_guidance
DB_POOL_MIN=1
DB_POOL_MAX=10

# Authentication; replace this locally and never commit the real value.
AUTH_SECRET=replace-with-a-local-secret-at-least-32-characters
TOKEN_EXPIRY_SECONDS=86400

# Optional local Ollama advisor. Leave blank to use the deterministic fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RESPONSE_CHARS=4000
AI_RETRY_ATTEMPTS=1
# Rolling aggregate observability; thresholds emit redacted one-per-window alerts.
METRICS_WINDOW_MS=300000
METRICS_ALERT_MIN_SAMPLES=10
API_ERROR_RATE_ALERT_THRESHOLD=0.2
AI_FAILURE_RATE_ALERT_THRESHOLD=0.3

# In-memory route protection; tune per environment and use shared infrastructure when scaling horizontally.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
CATALOG_RATE_LIMIT_WINDOW_MS=60000
CATALOG_RATE_LIMIT_MAX=60

# Development defaults to true; set RUN_SEED_DATA=false in production unless demo seed data is explicitly approved.
RUN_SEED_DATA=true
