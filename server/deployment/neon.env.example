# Copy these values into the approved server environment only.
# Never commit the real Neon connection string or password.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-a-long-random-production-secret
CORS_ORIGIN=https://your-frontend-deployment.example
DB_POOL_MIN=1
DB_POOL_MAX=5
# Keep true for the MVP so new catalog migrations apply on startup; applied migrations are skipped safely.
RUN_SEED_DATA=true
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RESPONSE_CHARS=4000
AI_RETRY_ATTEMPTS=1
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=30000
