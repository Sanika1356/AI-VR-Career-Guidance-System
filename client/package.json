{
  "name": "@ai-vr-career-guidance/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check": "pnpm format:check && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "pdfjs-dist": "^5.4.54",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "vite": "latest"
  }
}
