# Browser-safe API endpoint for local development.
# Do not place tokens, provider keys, or other secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:4000/api
# Keep unfinished immersive controls disabled; desktop fallback remains available.
VITE_ENABLE_WEBXR=false
# Keep adaptive sequencing opt-in; the complete question set remains the fallback.
VITE_ENABLE_ADAPTIVE_ASSESSMENT=false
